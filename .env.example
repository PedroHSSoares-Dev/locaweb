# Copie este arquivo para .env e ajuste o ambiente local
# cp .env.example .env

# Provider analítico ativo: `openai` (produção/demo) ou `ollama` (offline/local).
CHAT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_DEEP_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_COMPLEX_MAX_OUTPUT_TOKENS=1800
OPENAI_DEEP_MAX_OUTPUT_TOKENS=2200
OPENAI_RETRY_MAX_OUTPUT_TOKENS=3200
OPENAI_TIMEOUT_SECONDS=120

# Fallback local (zero custo por requisição)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b-it-qat
# Inicia `ollama serve` ao abrir a sessão, carrega o modelo e libera a RAM no logout.
OLLAMA_AUTOSTART=true
OLLAMA_PRELOAD_ON_SESSION=true
OLLAMA_STOP_MANAGED_SERVER_ON_LOGOUT=true
# Rede de segurança caso o navegador feche sem encerrar a sessão explicitamente.
OLLAMA_KEEP_ALIVE=15m
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=520
OLLAMA_DEEP_NUM_PREDICT=1100
CHAT_SESSION_SECRET=troque-por-um-segredo-longo
CHAT_SESSION_TTL_MINUTES=480
CHAT_RATE_LIMIT_PER_MINUTE=20
# Opcional em produção: compartilha cache, memória e rate limit entre workers.
CHAT_REDIS_URL=
CHAT_CACHE_ENABLED=true
CHAT_CACHE_TTL_SECONDS=900
CHAT_CACHE_MAX_ENTRIES=256
CHAT_SEMANTIC_CACHE_ENABLED=true
CHAT_SEMANTIC_CACHE_THRESHOLD=0.94
CHAT_MEMORY_TTL_SECONDS=28800
CHAT_MEMORY_MAX_MESSAGES=8
# Arquivo local por padrão. Em produção, aceite qualquer PostgreSQL compatível.
# Exemplo: postgresql+psycopg://usuario:senha@host:5432/predictfy
CHAT_DATABASE_URL=
# Data atual canônica dentro da aplicação; toda expressão temporal parte daqui.
CHAT_CURRENT_DATE=2025-12-31
CHAT_ALLOW_LOCAL_DEV=false
# Bypass explícito para desenvolvimento. Nunca habilite estas variáveis no Render.
CHAT_LOCAL_AUTH_BYPASS=false
CHAT_LOCAL_AUTH_EMAIL=pedrohssoares@live.com
CHAT_LOCAL_AUTH_TTL_MINUTES=60
# Bootstrap inicial: estes e-mails são criados como proprietários somente se
# ainda não existirem no diretório. A gestão cotidiana acontece em /admin.
ALLOWED_EMAILS=pedrohssoares@live.com
# Origens web autorizadas, separadas por vírgula e sem barra final.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Microsoft Entra ID — API registrada separadamente da SPA.
# Use `common` para aceitar contas FIAP e contas Microsoft pessoais autorizadas.
ENTRA_TENANT_ID=common
ENTRA_API_CLIENT_ID=
ENTRA_SPA_CLIENT_ID=
ENTRA_REQUIRED_SCOPE=access_as_user
# Opcional: restrinja por tenant quando a allowlist deixar de usar contas pessoais.
ENTRA_ALLOWED_TENANT_IDS=

# Webhook de alerta (Slack ou Teams)
WEBHOOK_URL=sua_url_aqui

# Threshold de risco OLA para disparar alerta (0-100)
OLA_ALERT_THRESHOLD=60
